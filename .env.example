# Netlify Serverless Function Environment Variable
# Add this in Netlify UI -> Site configuration -> Environment variables
N8N_LEAD_WEBHOOK_URL=https://muteebabaloch.app.n8n.cloud/webhook/agency-contact

# Local Vite Frontend Fallback (optional)
VITE_N8N_WEBHOOK_URL=https://muteebabaloch.app.n8n.cloud/webhook/agency-contact

# Application URL
VITE_APP_URL=http://localhost:5173
