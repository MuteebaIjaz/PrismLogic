# Netlify Serverless Function Environment Variable
# Add this in Netlify UI -> Site configuration -> Environment variables
N8N_LEAD_WEBHOOK_URL=https://your-subdomain.app.n8n.cloud/webhook/your-webhook-path

# Local Vite Frontend Fallback (optional)
VITE_N8N_WEBHOOK_URL=https://your-subdomain.app.n8n.cloud/webhook/your-webhook-path

# Application URL
VITE_APP_URL=http://localhost:5173
