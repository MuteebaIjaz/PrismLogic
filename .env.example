# Netlify Serverless Function Environment Variables
# Add these in Netlify UI -> Site configuration -> Environment variables
N8N_LEAD_WEBHOOK_URL=https://your-subdomain.app.n8n.cloud/webhook/your-webhook-path

# Option A: Full Authorization header (e.g., "Basic <base64>" or "Bearer <token>")
# N8N_AUTH_HEADER=Basic dXNlcm5hbWU6cGFzc3dvcmQ=

# Option B: Basic Auth credentials (auto-encoded by serverless proxy)
# N8N_BASIC_AUTH_USER=your_username
# N8N_BASIC_AUTH_PASSWORD=your_password

# Option C: Custom Header Authentication (e.g., for Header Auth in n8n)
# N8N_AUTH_HEADER_NAME=X-Webhook-Secret
# N8N_AUTH_HEADER_VALUE=your_custom_secret_token

# Local Vite Frontend Fallback (optional)
VITE_N8N_WEBHOOK_URL=https://your-subdomain.app.n8n.cloud/webhook/your-webhook-path

# Application URL
VITE_APP_URL=http://localhost:5173
