# n8n Webhook URL for Lead Qualification & Project Inquiry Automation
# When submitted, this endpoint receives:
# {
#   name: string,
#   email: string,
#   company: string,
#   phone: string,
#   service: string,
#   budget: string,
#   message: string,
#   consent: true,
#   source: "website-contact-form",
#   submittedAt: string (ISO timestamp),
#   pageUrl: string
# }
# Example: https://n8n.yourdomain.com/webhook/prism-lead-capture
VITE_N8N_WEBHOOK_URL=https://n8n.example.com/webhook/prism-lead-capture
